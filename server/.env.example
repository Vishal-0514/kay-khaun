# ── Server ──────────────────────────────────────────────────────────
PORT=4100

# ── MongoDB Atlas ───────────────────────────────────────────────────
# Paste the connection string from Atlas → Connect → Drivers.
MONGODB_URI=
MONGODB_DB=kyakhaun

# ── Sessions ────────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ── Password-reset emails ─────────────────────────────────────────
# console = codes are printed in this terminal (free; for building and testing)
EMAIL_PROVIDER=console
# For real email:  EMAIL_PROVIDER=smtp  (e.g. Gmail with an app password, or Brevo's free plan)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kya Khaun? <no-reply@example.com>"

# ── Google sign-in ──────────────────────────────────────────────────
# Comma-separated OAuth client IDs from Google Cloud Console (web, android, ios).
GOOGLE_CLIENT_IDS=

# ── AI (Claude) ─────────────────────────────────────────────────────
# Without a key the app still works: a keyword parser reads messages instead.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── Testing ─────────────────────────────────────────────────────────
# Shows "Skip login (testing only)" in the app. Ignored in production.
ALLOW_GUEST_LOGIN=false
