# ── Server ──────────────────────────────────────────────────────────
PORT=4100

# ── MongoDB Atlas ───────────────────────────────────────────────────
# Paste the connection string from Atlas → Connect → Drivers.
MONGODB_URI=
MONGODB_DB=kyakhaun

# ── Sessions ────────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ── Sign-in (Firebase) ─────────────────────────────────────────────
# Firebase handles email + password and Google sign-in (and sends the
# verification and password-reset emails). The server only needs the project
# ID to check sign-ins — no secret key. Firebase console → Project settings.
FIREBASE_PROJECT_ID=

# ── Real nearby restaurants (Google Places API (New)) ────────────────
# Without it, picks come from the sample Mumbai menu. Google Cloud → project
# kay-khaun → enable "Places API (New)" → Credentials → API key restricted to it.
GOOGLE_MAPS_API_KEY=

# ── AI (Claude) ─────────────────────────────────────────────────────
# Without a key the app still works: a keyword parser reads messages instead.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ── Testing ─────────────────────────────────────────────────────────
# Shows "Skip login (testing only)" in the app. Ignored in production.
ALLOW_GUEST_LOGIN=false

# ── Store pages and account deletion ────────────────────────────────
# Shown on /privacy, /terms and /delete-account as the contact address.
SUPPORT_EMAIL=
# Who provides the app (your name or company), shown on those pages.
LEGAL_NAME=
# Optional: Firebase service-account JSON (one line). With it, "Delete my
# account" also removes the Firebase sign-in. Firebase console → Project
# settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
