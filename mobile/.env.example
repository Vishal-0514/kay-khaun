# Where the app finds the server. On a real phone use your PC's Wi-Fi IP,
# e.g. http://192.168.1.20:4100/api (localhost only works in the web preview/emulator).
EXPO_PUBLIC_API_URL=http://localhost:4100/api

# Sign-in (Firebase): Firebase console → Project settings → Your apps → Web app →
# its firebaseConfig. They're public settings, not secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google sign-in: the "Web client" ID Firebase created (Authentication → Google →
# Web SDK configuration). Needs the installed development build, not Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
