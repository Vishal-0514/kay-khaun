# Where the app finds the server. On a real phone use your PC's Wi-Fi IP,
# e.g. http://192.168.1.20:4100/api (localhost only works in the web preview/emulator).
EXPO_PUBLIC_API_URL=http://localhost:4100/api

# Google sign-in (needs a development build; see README)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
